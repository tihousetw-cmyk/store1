# LINE Messaging API 設定
# 從 LINE Developers Console 取得 Channel Access Token
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# 接收訊息的 LINE User ID
# 可透過 Webhook 或 LINE Developers Console 取得
LINE_USER_ID=your_line_user_id_here

# 每日發送時間（24 小時制，台灣時間）
SEND_TIME=08:00

# 啟動時立即發送一次測試訊息（true/false）
TEST_ON_START=false
